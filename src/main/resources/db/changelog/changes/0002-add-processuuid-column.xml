<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0002-add-processuuid-column" author="seuUsuario">
        <addColumn tableName="usuario_processo">
            <column name="processo_uuid" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="usuario_empresa_processo">
            <column name="processo_uuid" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="usuario_contrato_empresa">
            <column name="processo_uuid" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="info_processo_usuario">
            <column name="processo_uuid" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
